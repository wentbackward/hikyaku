# Copy to scripts/.env.prod or scripts/.env.uat and fill in.
# These files are gitignored — do NOT commit real values.

REMOTE_USER=your-deploy-user
REMOTE_HOST=your-host-or-ip
SSH_KEY=$HOME/.ssh/id_deploy
# INSTALL_DIR is resolved on the REMOTE: absolute paths used as-is,
# relative paths joined with the remote user's $HOME. Do NOT use ~/ here —
# bash would expand it against your laptop's $HOME at source-time.
INSTALL_DIR=hikyaku

# Optional: cross-build for a different remote architecture.
# Leave unset to build for the local architecture (faster).
# Examples: linux/arm64 (Jetson, Pi 4/5, Apple Silicon Linux), linux/arm/v7 (Pi 3).
# DEPLOY_PLATFORM=linux/arm64

# Optional overrides:
# IMAGE_NAME=hikyaku
# VERSION=v0.4.0
